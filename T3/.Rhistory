color = "Género"
) +
theme_minimal() +
theme(plot.title = element_text(face = "bold", size = 14))
print(grafico_scatter)
# 5. Visualización y Análisis
# Relación total_bill vs tip, coloreado por sexo
# RL que no consideran total_bill (solo tip ~ sex)
grafico_scatter <- ggplot(tips, aes(x = total_bill, y = tip, color = sex)) +
geom_point(alpha = 0.6, size = 2.5) +
geom_smooth(method = "lm",
formula = y ~ 1,  # Solo intercepto, sin pendiente
se = TRUE,
alpha = 0.2) +
scale_color_manual(values = c("Female" = "#FF6B6B", "Male" = "#4ECDC4")) +
labs(
title = "Relación entre monto total y propina por género",
subtitle = "Female: tip_i=β_0+ε_i\nMale: tip_i=β_0+β_1*sex_i",
x = "Total de la cuenta ($)",
y = "Propina ($)",
color = "Género"
) +
theme_minimal() +
theme(plot.title = element_text(face = "bold", size = 14))
print(grafico_scatter)
total_bill_range <- seq(min(tips$total_bill), max(tips$total_bill), length.out = 100)
# Línea general del modelo (promedio entre géneros)
pred_general <- data.frame(
sex_num = 0.5,  # Valor promedio
total_bill = total_bill_range
)
pred_general$tip <- predict(modelo_multiple, newdata = data.frame(sex_num = 0, total_bill = total_bill_range))
pred_general$tipo <- "General"
# Línea para Female (sex_num = 0)
pred_female <- data.frame(
sex_num = 0,
total_bill = total_bill_range,
sex = "Female"
)
pred_female$tip <- predict(modelo_multiple, newdata = pred_female)
pred_female$tipo <- "Female"
# Línea para Male (sex_num = 1)
pred_male <- data.frame(
sex_num = 1,
total_bill = total_bill_range,
sex = "Male"
)
pred_male$tip <- predict(modelo_multiple, newdata = pred_male)
pred_male$tipo <- "Male"
# Combinar predicciones
pred_combined <- rbind(
pred_female %>% select(total_bill, tip, sex, tipo),
pred_male %>% select(total_bill, tip, sex, tipo)
)
# Gráfico con 3 líneas
grafico_scatter <- ggplot(tips, aes(x = total_bill, y = tip, color = sex)) +
geom_point(alpha = 0.6, size = 2.5) +
# Líneas por género del modelo múltiple
geom_line(data = pred_combined,
aes(x = total_bill, y = tip, color = sex),
linewidth = 1.3,
alpha = 0.9) +
scale_color_manual(values = c("Female" = "#FF6B6B", "Male" = "#4ECDC4")) +
labs(
title = "Modelo Extendido: tip ~ sex + total_bill",
subtitle = "Female: tip_i = β₀ + β₂·total_bill_i\nMale: tip_i = (β₀ + β₁) + β₂·total_bill_i",
x = "Total de la cuenta ($)",
y = "Propina ($)",
color = "Género"
) +
theme_minimal() +
theme(plot.title = element_text(face = "bold", size = 14),
plot.subtitle = element_text(size = 10))
print(grafico_scatter)
# 5. Visualización y Análisis
