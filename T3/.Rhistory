```
# 2, Modelos
cat("Modelo 1")
# Modelo 1: $M_1: mpg \sim hp$
M1 <- lm(mpg ~ hp, data = mtcars)
summary_M1 <- summary(M1)
print(summary_M1)
cat("Modelo 2")
# Modelo 2: $M_2: mpg \sim hp + wt$
M2 <- lm(mpg ~ hp + wt, data = mtcars)
summary_M2 <- summary(M2)
print(summary_M2)
cat("Modelo 3")
# Modelo 3: $M_3: mpg \sim hp + wt + cyl$
M3 <- lm(mpg ~ hp + wt + cyl, data = mtcars)
summary_M3 <- summary(M3)
print(summary_M3)
# 3. Comparación entre modelos
cat("\n\n=== COMPARACIÓN DE R² Y R² AJUSTADO ===\n")
comparacion_modelos <- data.frame(
Modelo = c("M1: mpg ~ hp",
"M2: mpg ~ hp + wt",
"M3: mpg ~ hp + wt + cyl"),
R_squared = c(summary_M1$r.squared,
summary_M2$r.squared,
summary_M3$r.squared),
R_squared_adj = c(summary_M1$adj.r.squared,
summary_M2$adj.r.squared,
summary_M3$adj.r.squared),
n_variables = c(1, 2, 3)
)
print(comparacion_modelos)
cat("\n=== ANÁLISIS ===\n")
cat("Cambio en R² de M1 a M2:",
round(summary_M2$r.squared - summary_M1$r.squared, 4), "\n")
cat("Cambio en R² ajustado de M1 a M2:",
round(summary_M2$adj.r.squared - summary_M1$adj.r.squared, 4), "\n\n")
cat("Cambio en R² de M2 a M3:",
round(summary_M3$r.squared - summary_M2$r.squared, 4), "\n")
cat("Cambio en R² ajustado de M2 a M3:",
round(summary_M3$adj.r.squared - summary_M2$adj.r.squared, 4), "\n")
# 3. Comparación entre modelos
comparacion_modelos <- data.frame(
Modelo = c("M1: mpg ~ hp",
"M2: mpg ~ hp + wt",
"M3: mpg ~ hp + wt + cyl"),
R_squared = c(summary_M1$r.squared,
summary_M2$r.squared,
summary_M3$r.squared),
R_squared_adj = c(summary_M1$adj.r.squared,
summary_M2$adj.r.squared,
summary_M3$adj.r.squared),
n_variables = c(1, 2, 3)
)
print(comparacion_modelos)
# 4. Variable irrelevante (control de sobreajuste)
cat("\n\n=== MODELO 4: mpg ~ hp + wt + cyl + noise (VARIABLE ALEATORIA) ===\n")
# Crear variable aleatoria sin relación con mpg
mtcars$noise <- rnorm(nrow(mtcars))
M4 <- lm(mpg ~ hp + wt + cyl + noise, data = mtcars)
summary_M4 <- summary(M4)
print(summary_M4)
# Comparación M3 vs M4
cat("\n=== COMPARACIÓN M3 vs M4 (CON VARIABLE ALEATORIA) ===\n")
comparacion_M3_M4 <- data.frame(
Modelo = c("M3: sin noise", "M4: con noise"),
R_squared = c(summary_M3$r.squared, summary_M4$r.squared),
R_squared_adj = c(summary_M3$adj.r.squared, summary_M4$adj.r.squared),
p_value_noise = c(NA, summary_M4$coefficients["noise", "Pr(>|t|)"])
)
print(comparacion_M3_M4)
cat("\nCambio en R²:",
round(summary_M4$r.squared - summary_M3$r.squared, 4), "\n")
cat("Cambio en R² ajustado:",
round(summary_M4$adj.r.squared - summary_M3$adj.r.squared, 4), "\n")
cat("p-value de noise:",
round(summary_M4$coefficients["noise", "Pr(>|t|)"], 4), "\n")
# 5. Tabla resumen final
cat("\n\n=== RESUMEN COMPLETO: TODOS LOS MODELOS ===\n")
resumen_final <- data.frame(
Modelo = c("M1: mpg ~ hp",
"M2: mpg ~ hp + wt",
"M3: mpg ~ hp + wt + cyl",
"M4: mpg ~ hp + wt + cyl + noise"),
R_squared = c(summary_M1$r.squared,
summary_M2$r.squared,
summary_M3$r.squared,
summary_M4$r.squared),
R_squared_adj = c(summary_M1$adj.r.squared,
summary_M2$adj.r.squared,
summary_M3$adj.r.squared,
summary_M4$adj.r.squared),
n_vars = c(1, 2, 3, 4)
)
print(resumen_final)
# Gráfico de R² vs R² ajustado
grafico_r2 <- ggplot(resumen_final, aes(x = n_vars)) +
geom_line(aes(y = R_squared, color = "R²"), linewidth = 1.2) +
geom_point(aes(y = R_squared, color = "R²"), size = 3) +
geom_line(aes(y = R_squared_adj, color = "R² ajustado"), linewidth = 1.2) +
geom_point(aes(y = R_squared_adj, color = "R² ajustado"), size = 3) +
scale_x_continuous(breaks = c(1, 2, 3, 4),
labels = c("M1", "M2", "M3", "M4")) +
scale_color_manual(values = c("R²" = "#F8766D", "R² ajustado" = "#00BA38")) +
labs(
title = "Comparación de R² y R² ajustado",
subtitle = "M4 incluye una variable aleatoria irrelevante",
x = "Modelo",
y = "Valor",
color = "Métrica"
) +
theme_minimal() +
theme(plot.title = element_text(face = "bold", size = 14))
print(grafico_r2)
