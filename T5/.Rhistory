beside = TRUE,
col = c("steelblue", "coral"),
names.arg = 1:length(coef_sin_reg),
xlab = "",
ylab = "Magnitud (valor absoluto)",
main = "Magnitud de Coeficientes: Sin Regularización vs Ridge",
las = 2,
legend = c("Sin Regularización", "Ridge"),
args.legend = list(x = "topright", cex = 0.9))
mtext("Término del Polinomio", side = 1, line = 5)
cat("\n========================================\n")
cat("5. DISCUSIÓN Y CONCLUSIONES\n")
cat("========================================\n\n")
# Resumen comparativo
cat("RESUMEN COMPARATIVO DE MÉTODOS:\n")
cat("--------------------------------\n")
cat(sprintf("Mejor modelo por AIC: Grado %d\n", grados[mejor_aic]))
cat(sprintf("Mejor modelo por BIC: Grado %d\n", grados[mejor_bic]))
cat(sprintf("Mejor modelo por CV: Grado %d\n\n", grados[mejor_cv]))
cat("SEÑALES DE UNDERFITTING Y OVERFITTING:\n")
cat("--------------------------------------\n")
cat("- UNDERFITTING (Grado 1-2):\n")
cat("  * RSS alto: el modelo no captura patrones importantes\n")
cat("  * Error de CV alto: generalización pobre por simplicidad excesiva\n\n")
cat("- PUNTO ÓPTIMO (Grado 2-3):\n")
cat("  * Balance entre sesgo y varianza\n")
cat("  * Mejor AIC/BIC: equilibrio entre ajuste y complejidad\n")
cat("  * Mejor CV-MSE: generalización óptima\n\n")
cat("- OVERFITTING (Grado 5-6):\n")
cat("  * RSS continúa bajando pero AIC/BIC aumentan\n")
cat("  * CV-MSE aumenta: el modelo se ajusta demasiado a datos de entrenamiento\n")
cat("  * Coeficientes grandes y variables (sin regularización)\n\n")
cat("CONTRIBUCIÓN DE LA REGULARIZACIÓN:\n")
cat("----------------------------------\n")
cat("1. REDUCCIÓN DE MAGNITUDES:\n")
cat("   Ridge reduce la magnitud de los coeficientes, especialmente\n")
cat("   los términos de alto grado que contribuyen al overfitting.\n\n")
cat("2. ESTABILIZACIÓN:\n")
cat("   Los coeficientes regularizados son más estables y menos\n")
cat("   sensibles a pequeños cambios en los datos de entrenamiento.\n\n")
cat("3. MEJOR GENERALIZACIÓN:\n")
cat("   Al penalizar la complejidad, Ridge previene que el modelo\n")
cat("   se ajuste excesivamente al ruido en los datos de entrenamiento,\n")
cat("   mejorando su capacidad de predicción en datos nuevos.\n\n")
cat("4. TRADE-OFF SESGO-VARIANZA:\n")
cat("   Ridge introduce un pequeño sesgo pero reduce drásticamente\n")
cat("   la varianza, resultando en un MSE total menor.\n\n")
